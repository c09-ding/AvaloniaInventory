<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Avalonia_DB_Connection"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             Width="1024" Height="768" HorizontalAlignment="Left" VerticalAlignment="Top"
             Background="Black" Foreground="White"
             x:Class="Avalonia_DB_Connection.Home"
             x:DataType="local:Home">
             <Grid ColumnSpacing="10" RowSpacing="10" Margin="20" 
                 RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*">
                 <TextBlock Grid.Column="1" Text="Computer Hardware Inventory" FontSize="28"
                            FontWeight="Bold" Foreground="white" Width="520" />
                 
                 <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1e" CornerRadius="10" 
                           Height="300" 
                           Width="400" 
                           Margin="40,90,600,0"
                           Padding="20"
                           HorizontalAlignment="Left">
                          <StackPanel>
                                    <TextBlock Text=" ⚠️  Critical Stock Inventory" 
                                             
                                               Foreground="Coral" 
                                               FontWeight="Bold"
                                               FontSize="26"
                                               TextAlignment="Center"/>
                                    <Border Height="2" Background="Gray" Margin="-20,10,-20,340"/>   
                                    
                                    <TableView Name="CriticalStock"
                                               
                                               Width="390"
                                               Height="150"
                                               ItemsSource="{Binding ItemStock }"
                                               Margin="0,-525,0,0">

                                        <TableView.Columns>
                                           

                                            <TableViewColumn Header="Product Name"
                                                             Width="1*"
                                                             Binding="{Binding item}"/>

                                            <TableViewColumn Header="Item Sold"
                                                             Width="1*"
                                                             Binding="{Binding Quantity}"/>
                                            
                                            <TableViewColumn Header="Status"
                                                             Width="1*"
                                                             Binding="{Binding status}"/>
                                        </TableView.Columns>
                                    </TableView>

                                    
                          </StackPanel>
                 </Border>
                 
                 
                 <Border Grid.Row="1"
                         Grid.Column="1"
                         Background="#1E1E1E"
                         CornerRadius="10"
                         Height="300"
                         Width="400"
                         Margin="200,90,600,0"
                         Padding="20"
                         HorizontalAlignment="Left">

                     <StackPanel Spacing="10">

                         <TextBlock Text="📶 Best Seller"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="26"
                                    HorizontalAlignment="Center"/>
                         
                         <Border Height="2" Background="Gray" Margin="-20,10,-20,340"/>   
                         <TableView Name="Table"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="390"
                                    Height="150"
                                    ItemsSource="{Binding SoldItem}"
                                    Margin="0,-540,0,0">

                             <TableView.Columns>
                                 <TableViewColumn Header="Rank"
                                                  Width="1*"
                                                  Binding="{Binding rank}"/>

                                 <TableViewColumn Header="Product Name"
                                                  Width="1*"
                                                  Binding="{Binding productname}"/>

                                 <TableViewColumn Header="Item Sold"
                                                  Width="1*"
                                                  Binding="{Binding Itemsold}"/>
                             </TableView.Columns>
                         </TableView>

                         

                     </StackPanel>

                 </Border>

                
                 <Border Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Background="#1E1E1E"
                         CornerRadius="10"
                         Padding="20"
                         Margin="40,320,-70,0"
                         Height="320"
                 >
                

            <StackPanel>
                <TextBlock Text="👤 Best Employee"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <Border Height="2"
                        Background="Gray"
                        Margin="0,10"/>

                <!-- Ito Ang table -->
                <Grid ColumnDefinitions="*,2*,*,*,*"
                      RowDefinitions="40,40,40,40,40,40"
                      HorizontalAlignment="Stretch">

                    <!-- Ito naman ay para sa header-->
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="#333333"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Rank"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                            Background="#333333"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Employee Name"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            Background="#333333"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Role"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="3"
                            Background="#333333"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Sales Handle"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="4"
                            Background="#333333"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Status"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Eto naman ay pangalan ng unang empleyado -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="🥇 1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Lexter Aguirre"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Leader"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="₱500"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Excellent"
                                   Foreground="LightGreen"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    
                    
                    

                    <!-- Eto naman ay pangalan ng pangalawang empleyado-->
                    <Border Grid.Row="2" Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="🥈 2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Neil Orosco"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Manager"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="₱300"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Good"
                                   Foreground="LightBlue"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Eto naman ay pangalan ng pangatlong empleyado -->
                    <Border Grid.Row="3" Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="🥉 3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Henjie Laurente"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Sales Staff"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="₱200"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Good"
                                   Foreground="LightBlue"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    
                    
                    
                    <!-- Eto naman ay pangalan ng pang-apat na empleyado -->
                    <Border Grid.Row="4" Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="🥉 4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Russell Burgos"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Sales Staff"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="₱100"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Good"
                                   Foreground="LightBlue"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    
                    
                    <Border Grid.Row="5" Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="🥉 5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Ann Santos"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Sales Staff"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="₱50"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <TextBlock Text="Failed"
                                   Foreground="Red"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>
            </StackPanel>
        </Border>

                 
             </Grid>
    
            
</UserControl>
